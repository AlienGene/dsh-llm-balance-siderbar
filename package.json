{
  "name": "dsh-llm-balance",
  "version": "0.7.1",
  "description": "DeepSeek Harness plugin for querying LLM service provider usage: reads each configured provider's remaining balance or subscription quota and shows it in an always-visible card in the web GUI.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "plugin",
    "balance",
    "quota",
    "usage",
    "kimi",
    "moonshot",
    "opencode",
    "ui"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./state": {
      "types": "./lib/state.d.ts",
      "default": "./lib/state.js"
    },
    "./format": {
      "types": "./lib/format.d.ts",
      "default": "./lib/format.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "assets",
    "docs"
  ],
  "license": "MIT",
  "author": "L.H",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlienGene/dsh-llm-balance-siderbar.git"
  },
  "homepage": "https://github.com/AlienGene/dsh-llm-balance-siderbar#readme",
  "bugs": {
    "url": "https://github.com/AlienGene/dsh-llm-balance-siderbar/issues"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "test": "node --test test/*.test.mjs",
    "preflight": "node scripts/preflight.mjs",
    "verify-live": "node scripts/verify-live.mjs",
    "prepack": "pnpm run build",
    "check": "pnpm run typecheck && pnpm run build && pnpm test && pnpm run preflight"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
